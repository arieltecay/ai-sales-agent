# AI-bot Frontend Environment Variables
# Copia este archivo a .env.local para desarrollo local
# En producción, configura estas variables en tu plataforma de deploy (Vercel/Netlify)

# URL del backend API (requerido)
# Desarrollo: http://localhost:3000
# Producción: https://api.tudominio.com
VITE_API_URL=http://localhost:3000